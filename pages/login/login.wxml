<view class="login-container">
  <view class="login-card">
    <view class="login-header">
      <text class="login-title">欢迎回来</text>
      <text class="login-subtitle">登录您的账户</text>
    </view>
    
    <view class="form-section">
      <view class="input-group">
        <text class="input-label">手机号</text>
        <input 
          class="input-field" 
          placeholder="请输入手机号" 
          value="{{phone}}"
          bindinput="onPhoneInput"
          maxlength="11"
        />
      </view>
      
      <view class="input-group">
        <text class="input-label">密码</text>
        <input 
          class="input-field" 
          placeholder="请输入密码" 
          password
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
    </view>
    
    <view class="button-section">
      <button class="login-btn" bindtap="onLogin">登录</button>
      <view class="register-link">
        <text class="link-text">还没有账户？</text>
        <text class="link-btn" bindtap="onGoToRegister">立即注册</text>
      </view>
    </view>
  </view>
</view>