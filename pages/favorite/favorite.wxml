<view class="page-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">我的收藏</text>
  </view>
  
  <!-- 收藏列表 -->
  <view class="favorite-list">
    <view class="favorite-item" wx:for="{{favoriteList}}" wx:key="id" bindtap="onMerchantTap" data-merchant="{{item}}">
      <view class="merchant-info">
        <view class="merchant-name">{{item.name}}</view>
        <view class="merchant-desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
      <view class="favorite-icon">❤️</view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{favoriteList.length === 0}}">
      <text class="empty-text">暂无收藏的店铺</text>
    </view>
  </view>
</view>