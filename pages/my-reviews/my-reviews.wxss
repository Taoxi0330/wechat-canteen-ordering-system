.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

.header {
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  height: 88rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back .icon {
  font-size: 40rpx;
  color: #333;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-right: 60rpx;
}

.content {
  padding: 20rpx;
}

.reviews-summary {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.summary-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #ff9800;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.review-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dish-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.review-info {
  flex: 1;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.merchant-name {
  font-size: 26rpx;
  color: #999;
}

.rating-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.stars {
  display: flex;
  gap: 8rpx;
  margin-right: 16rpx;
}

.star {
  font-size: 32rpx;
  color: #ddd;
}

.star.active {
  color: #ffc107;
}

.rating-text {
  font-size: 28rpx;
  color: #ff9800;
  font-weight: 500;
}

.review-content {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.review-content text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

.review-time {
  text-align: right;
}

.review-time text {
  font-size: 24rpx;
  color: #ccc;
}

.review-reply {
  background: #e6f7ff;
  border-left: 4rpx solid #1890ff;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.reply-label {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.reply-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.reply-time {
  font-size: 22rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #ccc;
}