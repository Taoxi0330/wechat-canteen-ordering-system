/* 首页样式 */

.page-container {
  background: var(--bg-color);
  min-height: 100vh;
  padding: 0 20rpx 20rpx;
}

/* 轮播框 */
.banner-container {
  margin-bottom: 20rpx;
  padding-top: 10rpx;
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.banner-swiper {
  height: 300rpx;
}

.banner-item {
  position: relative;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  padding: 40rpx 30rpx 20rpx;
}

/* 搜索框 */
.search-container {
  position: sticky;
  top: 0;
  z-index: 100;
  margin-bottom: 20rpx;
  padding-top: 20rpx;
}

/* 注册登录板块 */
.auth-container {
  margin-bottom: 40rpx;
}

.auth-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  text-align: center;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.user-details {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.user-phone {
  font-size: 24rpx;
  color: #999;
}

.auth-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.auth-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-bottom: 40rpx;
}

.auth-buttons {
  display: flex;
  gap: 20rpx;
}

.auth-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
  text-align: center;
}

.auth-btn:active {
  transform: scale(0.98);
}

.login-btn {
  background: var(--primary-color);
  color: #fff;
}

.register-btn {
  background: #fff;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}

.logout-btn {
  background: #ff6b6b;
  color: #fff;
}

/* 堂食外卖板块 */
.dining-container {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.dining-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  text-align: center;
  transition: all 0.3s;
}

.dining-card:active {
  transform: scale(0.98);
}

.dining-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
  display: block;
}

.dining-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.dining-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
}

.eat-in-card {
  border: 2rpx solid var(--success-color);
}

.takeaway-card {
  border: 2rpx solid var(--warning-color);
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 32rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  transition: all 0.3s;
}

.search-box:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  color: var(--text-color-light);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color);
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-color-lighter);
}

.home-content {
  text-align: center;
  padding: 40rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 20rpx;
  display: block;
}

.page-desc {
  font-size: 32rpx;
  color: var(--text-color-light);
}

  