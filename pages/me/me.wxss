/* 我的页面样式 */

.page-container {
  background: var(--bg-color);
  min-height: 100vh;
}

/* 上半部分：登录板块 */
.login-section {
  background: var(--primary-color);
  padding: 60rpx 40rpx;
  color: #fff;
}

.login-content {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.login-content .login-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.user-phone {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
}

.logout-btn {
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #fff;
}

.avatar-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  position: relative;
}

.avatar-edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f5f5f5;
}

.login-info {
  flex: 1;
}

.login-text {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.login-desc {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
}

/* 下半部分：我的服务 */
.service-section {
  margin-top: 20rpx;
  background: #fff;
  padding: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 24rpx;
  padding-left: 10rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  cursor: pointer;
}

.service-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.service-name {
  font-size: 24rpx;
  color: var(--text-color);
  text-align: center;
}

/* 下半部分：设置板块 */
.setting-section {
  margin-top: 20rpx;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.setting-list {
  display: flex;
  flex-direction: column;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 10rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-name {
  font-size: 26rpx;
  color: var(--text-color);
}

.setting-arrow {
  font-size: 32rpx;
  color: var(--text-color-lighter);
}

