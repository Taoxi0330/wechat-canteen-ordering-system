<view class="page-container">
  <!-- 顶部操作栏 -->
  <view class="header">
    <view class="back-btn" bindtap="onBack">
      <text>←</text>
    </view>
    <view class="title">我的地址</view>
    <view class="add-btn" bindtap="onAddAddress">
      <text>+ 新增</text>
    </view>
  </view>
  
  <!-- 地址列表 -->
  <view class="address-list">
    <view 
      class="address-item {{selectedAddressId == item.id ? 'selected' : ''}}" 
      wx:for="{{addresses}}" 
      wx:key="id"
      bindtap="onSelectAddress"
      data-address="{{item}}"
    >
      <view class="address-info">
        <view class="address-header">
          <text class="name">{{item.name}}</text>
          <text class="phone">{{item.phone}}</text>
          <view class="default-tag" wx:if="{{item.is_default == 1}}">
            <text>默认</text>
          </view>
        </view>
        <text class="address-detail">{{item.address}}</text>
      </view>
      
      <view class="address-actions" catchtap="stopPropagation">
        <view class="action-btn" bindtap="onEditAddress" data-id="{{item.id}}">
          <text>编辑</text>
        </view>
        <view class="action-btn delete-btn" bindtap="onDeleteAddress" data-id="{{item.id}}">
          <text>删除</text>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{addresses.length === 0}}">
      <text class="empty-icon">📍</text>
      <text class="empty-text">暂无地址</text>
    </view>
  </view>
  
  <!-- 底部添加按钮 -->
  <view class="footer-add" wx:if="{{addresses.length > 0}}">
    <view class="add-btn-large" bindtap="onAddAddress">
      <text>+ 新增地址</text>
    </view>
  </view>
</view>