/* 小程序全局样式 */

/* 全局变量 */
page {
    --primary-color: #409eff;
    --success-color: #67c23a;
    --warning-color: #e6a23c;
    --danger-color: #f56c6c;
    --info-color: #909399;
    --border-color: #ebeef5;
    --text-color: #409eff;
    --text-color-light: #606266;
    --text-color-lighter: #909399;
    --bg-color: #f5f5f5;
    --white: #ffffff;
    --shadow: 0 2px 12px 0 rgba(43, 136, 223, 0.1);
  }
  
  /* 基础样式重置 */
  page {
    background-color: var(--bg-color);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Helvetica, Arial, sans-serif;
    font-size: 28rpx;
    color: var(--text-color);
    line-height: 1.5;
  }
  
  /* 容器样式 */
  .container {
    padding: 20rpx;
  }
  
  .page-container {
    min-height: 100vh;
    background-color: var(--bg-color);
  }
  
  /* 卡片样式 */
  .card {
    background: var(--white);
    border-radius: 16rpx;
    box-shadow: var(--shadow);
    margin: 20rpx;
    overflow: hidden;
  }
  
  .card-header {
    padding: 30rpx;
    border-bottom: 2rpx solid var(--border-color);
    font-size: 32rpx;
    font-weight: 600;
  }
  
  .card-body {
    padding: 30rpx;
  }
  
  /* 按钮样式 */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 20rpx 40rpx;
    border-radius: 8rpx;
    font-size: 28rpx;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
  }
  
  .btn-primary {
    background: var(--primary-color);
    color: var(--white);
  }
  
  .btn-primary:active {
    background: #3a8ee6;
  }
  
  .btn-success {
    background: var(--success-color);
    color: var(--white);
  }
  
  .btn-warning {
    background: var(--warning-color);
    color: var(--white);
  }
  
  .btn-danger {
    background: var(--danger-color);
    color: var(--white);
  }
  
  .btn-small {
    padding: 12rpx 24rpx;
    font-size: 24rpx;
  }
  
  .btn-large {
    padding: 28rpx 56rpx;
    font-size: 32rpx;
  }
  
  /* 列表样式 */
  .list {
    background: var(--white);
  }
  
  .list-item {
    display: flex;
    align-items: center;
    padding: 30rpx;
    border-bottom: 2rpx solid var(--border-color);
    position: relative;
  }
  
  .list-item:last-child {
    border-bottom: none;
  }
  
  .list-item:active {
    background: #f5f5f5;
  }
  
  /* 标签样式 */
  .tag {
    display: inline-block;
    padding: 6rpx 16rpx;
    font-size: 24rpx;
    border-radius: 6rpx;
    border: 2rpx solid var(--border-color);
    background: var(--white);
    color: var(--text-color);
  }
  
  .tag-primary {
    background: rgba(64, 158, 255, 0.1);
    color: var(--primary-color);
    border-color: var(--primary-color);
  }
  
  .tag-success {
    background: rgba(147, 214, 114, 0.1);
    color: var(--success-color);
    border-color: var(--success-color);
  }
  
  .tag-warning {
    background: rgba(230, 162, 60, 0.1);
    color: var(--warning-color);
    border-color: var(--warning-color);
  }
  
  .tag-danger {
    background: rgba(245, 108, 108, 0.1);
    color: var(--danger-color);
    border-color: var(--danger-color);
  }
  
  /* 文本样式 */
  .text-primary { color: var(--primary-color); }
  .text-success { color: var(--success-color); }
  .text-warning { color: var(--warning-color); }
  .text-danger { color: var(--danger-color); }
  .text-info { color: var(--info-color); }
  .text-light { color: var(--text-color-light); }
  .text-lighter { color: var(--text-color-lighter); }
  
  .text-center { text-align: center; }
  .text-left { text-align: left; }
  .text-right { text-align: right; }
  
  .text-bold { font-weight: bold; }
  .text-normal { font-weight: normal; }
  
  /* 尺寸工具类 */
  .w-100 { width: 100%; }
  .h-100 { height: 100%; }
  
  /* 间距工具类 */
  .mt-10 { margin-top: 20rpx; }
  .mt-20 { margin-top: 40rpx; }
  .mb-10 { margin-bottom: 20rpx; }
  .mb-20 { margin-bottom: 40rpx; }
  .ml-10 { margin-left: 20rpx; }
  .mr-10 { margin-right: 20rpx; }
  
  .p-10 { padding: 20rpx; }
  .p-20 { padding: 40rpx; }
  .pt-10 { padding-top: 20rpx; }
  .pb-10 { padding-bottom: 20rpx; }
  .pl-10 { padding-left: 20rpx; }
  .pr-10 { padding-right: 20rpx; }
  
  /* 布局工具类 */
  .flex {
    display: flex;
  }
  
  .flex-1 {
    flex: 1;
  }
  
  .flex-center {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .flex-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .flex-around {
    display: flex;
    justify-content: space-around;
    align-items: center;
  }
  
  .flex-column {
    display: flex;
    flex-direction: column;
  }
  
  .align-center {
    align-items: center;
  }
  
  .justify-center {
    justify-content: center;
  }
  
  /* 价格显示 */
  .price {
    color: var(--danger-color);
    font-weight: bold;
  }
  
  .price::before {
    content: '¥';
    font-size: 0.8em;
  }
  
  /* 数量选择器 */
  .quantity-selector {
    display: flex;
    align-items: center;
  }
  
  .quantity-btn {
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    background: var(--primary-color);
    color: var(--white);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .quantity-btn:disabled {
    background: #ccc;
  }
  
  .quantity-input {
    margin: 0 20rpx;
    text-align: center;
    min-width: 60rpx;
  }
  
  /* 食物卡片 */
  .food-card {
    background: var(--white);
    border-radius: 16rpx;
    margin: 20rpx;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  
  .food-image {
    width: 100%;
    height: 300rpx;
    background: #f5f5f5;
  }
  
  .food-info {
    padding: 24rpx;
  }
  
  .food-name {
    font-size: 32rpx;
    font-weight: 600;
    margin-bottom: 12rpx;
  }
  
  .food-desc {
    font-size: 26rpx;
    color: var(--text-color-light);
    margin-bottom: 16rpx;
  }
  
  .food-price {
    font-size: 36rpx;
    color: var(--danger-color);
    font-weight: bold;
  }
  
  /* 商家卡片 */
  .merchant-card {
    background: var(--white);
    border-radius: 16rpx;
    margin: 20rpx;
    padding: 30rpx;
    box-shadow: var(--shadow);
  }
  
  .merchant-header {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .merchant-logo {
    width: 80rpx;
    height: 80rpx;
    border-radius: 12rpx;
    margin-right: 20rpx;
    background: #f5f5f5;
  }
  
  .merchant-info {
    flex: 1;
  }
  
  .merchant-name {
    font-size: 32rpx;
    font-weight: 600;
    margin-bottom: 8rpx;
  }
  
  .merchant-desc {
    font-size: 26rpx;
    color: var(--text-color-light);
  }
  
  /* 订单卡片 */
  .order-card {
    background: var(--white);
    border-radius: 16rpx;
    margin: 20rpx;
    padding: 30rpx;
    box-shadow: var(--shadow);
  }
  
  .order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .order-no {
    font-size: 28rpx;
    color: var(--text-color-light);
  }
  
  .order-status {
    font-size: 26rpx;
  }
  
  .order-items {
    margin-bottom: 20rpx;
  }
  
  .order-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12rpx 0;
    border-bottom: 2rpx solid var(--border-color);
  }
  
  .order-item:last-child {
    border-bottom: none;
  }
  
  .order-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .order-total {
    font-size: 32rpx;
    font-weight: bold;
  }
  
  /* 空状态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 40rpx;
    color: var(--text-color-lighter);
  }
  
  .empty-icon {
    font-size: 100rpx;
    margin-bottom: 30rpx;
  }
  
  .empty-text {
    font-size: 28rpx;
  }
  
  /* 加载中 */
  .loading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60rpx;
    color: var(--text-color-lighter);
  }
  
  